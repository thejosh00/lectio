{
  "name": "lectio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal tutor that teaches you something every day: an app that keeps the lessons and the gradebook, and an agent that writes them",
  "bin": {
    "lectio": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts serve --dev",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun test && bun run test:browser",
    "test:unit": "bun test tests/unit",
    "build": "bun build --compile --minify src/cli.ts --outfile dist/lectio",
    "test:fast": "bun run typecheck && bun test",
    "test:browser": "playwright test",
    "test:real": "LECTIO_REAL_DATA=${LECTIO_DIR:-$HOME/.lectio} playwright test --project=iphone-webkit --project=desktop-chromium",
    "test:live": "bun run tests/live/tutor.ts",
    "check:migrations": "bun run scripts/check-migrations.ts",
    "test:full": "bun run test && bun run check:migrations && bun run test:real && bun run test:live"
  },
  "dependencies": {
    "d3": "7.9.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "p5": "1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/bun": "^1.4.2",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "typescript": "^5.9.0"
  }
}
